# R&R Newtech Store — environment variables
# Copy to .env.local and fill in. The site BUILDS AND RUNS with all of these empty
# (analytics no-op cleanly, catalog is seeded from code) — nothing here is required for Phase 1.

# --- Analytics & Ads (optional in Phase 1, recommended before running paid traffic) ---
# Meta (Facebook) Pixel ID — enables PageView + ecommerce events (ViewContent, AddToCart).
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# Public site URL used for canonical links, sitemap, and OG tags.
# Falls back to https://rrnewtech.ph when unset — so set it to http://localhost:3000 in local
# development, otherwise gateway return URLs point at the live site.
NEXT_PUBLIC_SITE_URL=

# --- Firebase (rnr-dental-clinics) — Firestore, Auth, and Storage ---
# Service account: Firebase console → Project settings → Service accounts → Generate new private
# key. Copy the three values out of the downloaded JSON. Keep FIREBASE_PRIVATE_KEY on one line
# with the newlines written as literal \n (wrap the whole value in double quotes).
FIREBASE_PROJECT_ID=rnr-dental-clinics
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Web API key (Project settings → General → Web API key) — used to verify admin AND customer
# login passwords, and to have Firebase send its templated "verify your email" message at sign-up.
FIREBASE_WEB_API_KEY=
# Storage bucket for uploaded images, e.g. rnr-dental-clinics.appspot.com. Optional for the admin's
# image uploads, but REQUIRED for customer sign-up — that's where the PRC ID photo is stored.
FIREBASE_STORAGE_BUCKET=

# Session cookie secret — REQUIRED. Generate one with: openssl rand -hex 32
# Signs the staff session, and (via a derived key) the customer session — see session-cookie.ts.
ADMIN_SESSION_SECRET=

# --- PayMongo (checkout) ---
# The site BUILDS AND RUNS with these empty: checkout falls back to recording the order and having
# the team arrange payment, exactly as it did before the gateway existed.
#
# API secret key — PayMongo dashboard → Developers → API keys. `sk_test_…` or `sk_live_…`; the
# prefix is what selects test vs live behaviour throughout the app.
PAYMONGO_SECRET_KEY=
# Signing secret for the webhook you created (`whsk_…`). NOT on the API keys page — it is returned
# once, when the webhook is created, and test and live webhooks have different secrets:
#   curl https://api.paymongo.com/v1/webhooks -u sk_test_XXXX: -H 'Content-Type: application/json' \
#     -d '{"data":{"attributes":{"url":"https://YOUR-DOMAIN/api/paymongo/webhook",
#          "events":["checkout_session.payment.paid","payment.paid","payment.failed"]}}}'
PAYMONGO_WEBHOOK_SECRET=
# Not used: checkout sessions are created entirely server-side. Only needed if card details are
# ever collected in the browser (Payment Element / tokenization).
# PAYMONGO_PUBLIC_KEY=
#
# NOTE: every method listed in src/lib/payment-methods.ts must be ACTIVATED on the PayMongo
# account. An inactive one doesn't quietly disappear from the hosted page — PayMongo rejects the
# whole create-session call with a 400, taking down ALL payments rather than just that method.

# --- Phase 2 (transactional email) — NOT used yet, listed here so the roadmap is visible ---
# Receipts will be sent from here, under our own branding — PayMongo's receipt email is
# deliberately switched off (see the session payload in src/app/(store)/actions.ts).
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Customer accounts (storefront sign-in / sign-up) ---
# No extra variables: accounts use the FIREBASE_* values above. Two things must be set up in the
# Firebase console for the flow to work end to end:
#   1. Authentication → Sign-in method → Email/Password: enabled.
#   2. Authentication → Templates → Address verification: this is the email Firebase sends at
#      sign-up. Edit the wording/sender there; the app never composes it.
# Optional: add the value of NEXT_PUBLIC_SITE_URL to Authentication → Settings → Authorized
# domains, so the verification email can return people to /account/login?verified=1. Without it the
# email still sends — the visitor just lands on Firebase's own confirmation page instead.
