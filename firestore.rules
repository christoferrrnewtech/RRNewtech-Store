rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Customer profiles carry PRC licence numbers, phone numbers and email addresses. The whole
    // app reaches them through the Admin SDK, which bypasses these rules, so no client ever needs
    // access — and the open catch-all below would otherwise expose the lot to anyone holding the
    // project's public web API key. Denied explicitly, and BEFORE the catch-all.
    //
    // The `{document=**}` is load-bearing, not decoration. `match /storeCustomers/{uid}` alone
    // matches ONLY the profile document — subcollections under it are not covered by their parent's
    // rules and would fall straight through to the catch-all below. That left the address book
    // (`storeCustomers/{uid}/addresses/{id}`) and now the saved cart
    // (`storeCustomers/{uid}/cart/current`) world-readable and world-WRITABLE to anyone with the
    // web API key, which is published in the client bundle by design. Anything added under a
    // customer inherits this deny only because of the recursive wildcard — keep it.
    match /storeCustomers/{uid}/{document=**} {
      allow read, write: if false;
    }

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2035, 3, 13);
    }
  }
}